<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Lockvyn</AssemblyName>
    <Product>Lockvyn</Product>
    <Title>Lockvyn</Title>
    <Description>Private password manager for Windows and Android</Description>
    <Version>1.14.0</Version>
    <StartupObject>BoshaVault.Windows.Program</StartupObject>
    <ApplicationIcon>Assets/lockvyn.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../BoshaVault.Core/BoshaVault.Core.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Velopack" Version="1.2.161" /></ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <EmbeddedResource Include="Assets/lockvyn.ico" LogicalName="Lockvyn.TrayIcon" />
    <Resource Include="Assets/lockvyn-mark.png" />
  </ItemGroup>
</Project>
