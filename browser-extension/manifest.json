{
  "manifest_version": 3,
  "name": "BoshaVault Autofill (Local Preview)",
  "version": "0.4.0",
  "description": "User-approved local autofill through the BoshaVault Windows app. No cloud service.",
  "permissions": ["nativeMessaging", "webNavigation", "activeTab"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["password-utils.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": { "default_title": "BoshaVault Autofill", "default_popup": "popup.html" }
}
