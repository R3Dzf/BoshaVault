{
  "manifest_version": 3,
  "name": "Lockvyn Autofill",
  "version": "0.7.0",
  "description": "Private HTTPS autofill, with optional quiet mode and user-approved local Lockvyn Windows connection.",
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "password-utils.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Lockvyn Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lockvyn-16.png",
      "32": "icons/lockvyn-32.png"
    }
  },
  "icons": {
    "16": "icons/lockvyn-16.png",
    "32": "icons/lockvyn-32.png",
    "48": "icons/lockvyn-48.png",
    "128": "icons/lockvyn-128.png"
  }
}
